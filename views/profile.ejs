<!doctype html>
<html>

<head>
    <title>21 Savage Fan Site</title>
    <link rel="stylesheet" href="//netdna.bootstrapcdn.com/bootstrap/3.0.2/css/bootstrap.min.css">
    <link rel="stylesheet" href="//netdna.bootstrapcdn.com/font-awesome/4.0.3/css/font-awesome.min.css">
    <link rel="stylesheet" href="style.css">
</head>

<body>
    <div class="container">

        <div class="page-header text-center">
            <h1>My Profile</h1>
            <a href="/logout" class="btn btn-default btn-sm">Logout</a>
        </div>

        <div class="row">

            <!-- LOCAL INFORMATION -->
            <div class="col-sm-6">
            <div class="well">
                <h3><span class="fa fa-user"></span> My Info</h3>

                    <% if (user.local.email) { %>
                    <p>
                    <strong>id</strong>: <%= user._id %><br>
                    <strong>email</strong>: <%= user.local.email %><br>
                    

                    <a href="/unlink/local" class="btn btn-default">Unlink</a>
                    <% } else { %>
                    <a href="/connect/local" class="btn btn-default">Connect Local</a>
                    <% } %>

                    </div>
                </div>
                 <div class="col-sm-6">
                <h3>My Recipes</h3>
                <ul class="messages">
                    <% for(let i=0; i<messages.length; i++) {%>
                     <li class="message">
                     <span data-user-id="<%= messages[i]._id %>">
                         <%= messages[i].name %>
                            </span>
                            <span>
                                <%= messages[i].msg %>
                            </span>
                            <span>
                                <%= messages[i].thumbUp %>
                            </span>
                           
                            <span><i class="fa fa-thumbs-up" aria-hidden="true"> Liked recipe</i></span>
                            <span><i class="fa fa-thumbs-down" aria-hidden="true"> Disliked recipe</i></span>
                            <span><i class="fa fa-trash" aria-hidden="true">🗑️ Delete recipe</i></span>
                        </li>
                        <% } %>
                </ul>

                <h2>Add a Recipe</h2>
                <% if (user.local.email) { %>
                    <form action="/messages" method="POST">
                    <input type="text" placeholder="Recipe Name" name="name">
                    <input type="text" placeholder="Recipe" name="msg">
                    <button type="submit">Add</button>
                    </form>
            </div>
            <% } %>

        </div>

        <script src="main.js"></script>

</body>

</html>
